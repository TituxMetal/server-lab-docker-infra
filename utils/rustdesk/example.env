# RustDesk server - copy to `.env` next to compose.yaml and fill in.
# When deployed through Arcane, set the same variables in the project instead:
# `.env` is gitignored and is not part of a git deployment.

# Instance label used in container names: rustdesk-id-<instance>,
# rustdesk-relay-<instance>. Informational only.
RUSTDESK_INSTANCE=laura

# Hostname advertised to the clients for the relay (port 21117).
# Keep the name that is already configured on the clients, NOT the hostname of
# whichever machine currently runs the server: it is what makes a migration
# transparent for them.
RUSTDESK_RELAY_HOST=laura.lgdweb.ovh

# Public key only. This is what the clients have in their "Key" field and what
# hbbr uses to reject relay requests that do not carry it.
#
# The matching private key (id_ed25519) must be present in the rustdesk-data
# volume BEFORE the first start: hbbs signs the peer public keys with it, and
# every deployed client already trusts this public key. Without it hbbs
# generates a fresh pair and every client fails to connect.
#
#   docker volume create rustdesk-data
#   install -m 600 id_ed25519     /var/lib/docker/volumes/rustdesk-data/_data/id_ed25519
#   install -m 644 id_ed25519.pub /var/lib/docker/volumes/rustdesk-data/_data/id_ed25519.pub
#
# Never pass the public key as `hbbs -k <key>`: hbbs then skips id_ed25519
# entirely and runs without a signing key.
RUSTDESK_KEY=QrrSBjpl1L1nbJNqjCkNfrKsSOSxYappCZavaPp1db8=
