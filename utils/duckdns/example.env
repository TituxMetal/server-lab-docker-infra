# DuckDNS updater - copy to `.env` next to compose.yaml and fill in.
# When deployed through Arcane, set the same variables in the project instead:
# `.env` is gitignored and is not part of a git deployment.

# Hostname suffix used in the container name (duckdns-<host>).
# This service is deployed on homelab only.
HOSTNAME=homelab

# DuckDNS subdomain(s), comma separated, without `.duckdns.org`.
SUBDOMAINS=

# DuckDNS token, from https://www.duckdns.org/ -> account.
TOKEN=
