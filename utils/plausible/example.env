# Hostname suffix used in the container names (plausible-<host>,
# plausible-db-<host>, plausible-events-db-<host>).
HOSTNAME=homelab

# Required configuration
# https://github.com/plausible/community-edition/wiki/configuration#required
BASE_URL=https://analytics.example.com

# 64 hex characters. Generate it on your machine, then paste the output here:
#   openssl rand -hex 32
SECRET_KEY_BASE=

# Optional configuration
# https://github.com/plausible/community-edition/wiki/configuration#optional

# Registration
TOTP_VAULT_KEY=
DISABLE_REGISTRATION=
ENABLE_EMAIL_VERIFICATION=

# Web
HTTP_PORT=
HTTPS_PORT=

# Database
# DATABASE_URL is derived from POSTGRES_PASSWORD by compose.yaml and must not
# be set here (the `environment` block of the plausible service wins anyway).
# Change it before the first start only.
# Generate it on your machine, then paste the output here:
#   openssl rand -base64 24
POSTGRES_PASSWORD=
CLICKHOUSE_DATABASE_URL=

# Google integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IP Geolocation
IP_GEOLOCATION_DB=
GEONAMES_SOURCE_FILE=
MAXMIND_LICENSE_KEY=
MAXMIND_EDITION=

# Email / SMTP
MAILER_ADAPTER=
MAILER_EMAIL=
MAILER_NAME=
SMTP_HOST_ADDR=
SMTP_HOST_PORT=
SMTP_USER_NAME=
SMTP_USER_PWD=
SMTP_HOST_SSL_ENABLED=
