# Arcane manager — copy to `.env` next to compose.yaml and fill in.

# Hostname suffix used in the container name (arcane-manager-<instance>).
# Set it explicitly: `$HOSTNAME` is only expanded from a shell, never by Arcane.
ARCANE_INSTANCE=homelab
ARCANE_VERSION=v3.1.1

# Public URL of the manager, served by the reverse proxy.
APP_URL=https://arcane.example.com

PUID=1000
PGID=1000

# Generate it on your machine, then paste the output here:
#   openssl rand -hex 32
# Never change it once the manager holds data.
ENCRYPTION_KEY=

# Must be `arc_` followed by 64 hex characters, prefix included. Any other
# format is rejected at startup. Safe to rotate.
# Generate it on your machine, then paste the output here:
#   printf 'arc_%s\n' "$(openssl rand -hex 32)"
ADMIN_STATIC_API_KEY=

# CIDR of the reverse proxy network; Arcane trusts it for client IP headers.
TRUSTED_PROXIES=192.168.10.0/26
