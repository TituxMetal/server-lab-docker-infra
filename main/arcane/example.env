# Arcane manager — copy to `.env` next to compose.yaml and fill in.

ARCANE_INSTANCE=$HOSTNAME
ARCANE_VERSION=v2.17.3

# Public URL of the manager, served by the reverse proxy.
APP_URL=https://arcane.example.com

PUID=1000
PGID=1000

# openssl rand -hex 32
# Never change it once the manager holds data.
ENCRYPTION_KEY=

# `arc_` + openssl rand -hex 32 (64 hex characters, prefix included).
# Any other format is rejected at startup. Safe to rotate.
ADMIN_STATIC_API_KEY=

# CIDR of the reverse proxy network; Arcane trusts it for client IP headers.
TRUSTED_PROXIES=192.168.10.0/26
