# Nginx Proxy Manager - copy to `.env` next to compose.yaml and fill in.
# When deployed through Arcane, set the same variable in the project instead:
# `.env` is gitignored and is not part of a git deployment.

# Hostname suffix used in the container names (nginx-proxy-manager-<host>,
# main-site-<host>).
# When deployed through the CLI, compose falls back to the shell's `$HOSTNAME`;
# set it explicitly anyway so an Arcane deployment names the containers the same
# way the Ansible-generated fleet does.
HOSTNAME=homelab
