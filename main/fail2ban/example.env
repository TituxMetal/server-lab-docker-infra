# Fail2ban - copy to `.env` next to compose.yaml.
# When deployed through Arcane, set the same variables in the project instead:
# `.env` is gitignored and is not part of a git deployment.

# Hostname suffix used in the container name (fail2ban-<host>).
# A real value, not $serverName: an undefined variable interpolates to an empty
# string and the container ends up named \`fail2ban-\`.
HOSTNAME=homelab

# No SMTP variables: notifications go through the host MTA on 127.0.0.1:25
# (exim4). There is no mail sidecar container any more.
