# Logi Prod Report - copy to `.env` next to compose.yaml and fill in.
# When deployed through Arcane, set the same variables in the project instead:
# `.env` is gitignored and is not part of a git deployment.

# Hostname suffix used in the container name (logi-prod-report-<host>).
HOSTNAME=homelab

DATABASE_URL="file:./data.sqlite?connection_limit=1"

# Injected by compose.yaml as the container's SESSION_SECRET.
# Generate it on your machine, then paste the output here:
#   openssl rand -hex 32
AUTH_SESSION_SECRET=
